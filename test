#!/usr/bin/env python3
"""Run every test suite in the checkout and print one summary table.

    ./test                 all suites
    ./test rebox rekit     only suites whose name contains one of these words
    ./test -v              also print each suite's full output

Suites that need Docker or the dsh CLI are reported as skipped when those are
not available. Exit code 0 only when nothing failed.
"""

from __future__ import annotations

import glob
import os
import shutil
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.realpath(__file__))
TOOLS = os.path.join(ROOT, "tools")
DSH = os.environ.get("REW_DSH") or \
    "/Applications/DeepSeek Harness.app/Contents/Resources/runtime/cli/bin/dsh"
TIMEOUT = 1800


def have_docker():
    exe = shutil.which("docker")
    if not exe:
        return False
    try:
        return subprocess.run([exe, "info"], capture_output=True, timeout=20).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def suites():
    """(name, cwd, command, needs) for every suite, in a fixed order."""
    out = []
    for tool in ("remu", "recalc", "rebox"):
        cwd = os.path.join(TOOLS, tool)
        py = os.path.join(cwd, ".venv", "bin", "python")
        out.append((tool, cwd, [py, "-m", "pytest", "-q", "-p", "no:cacheprovider"], {"venv:" + py}))
    scripts = sorted(glob.glob(os.path.join(TOOLS, "rekit", "test_*.py"))) \
        + sorted(glob.glob(os.path.join(TOOLS, "reworker", "test_*.py"))) \
        + sorted(glob.glob(os.path.join(TOOLS, "jsworker", "tests", "test_*.py")))
    needs = {"test_integration.py": {"dsh"}, "test_mcp.py": {"docker"},
             "test_escape.py": {"docker"}, "test_flow.py": {"docker", "dsh"}}
    for path in scripts:
        tool = os.path.relpath(path, TOOLS).split(os.sep)[0]
        base = os.path.basename(path)
        out.append(("%s/%s" % (tool, base[:-3]), os.path.dirname(path),
                    [sys.executable, base], needs.get(base, set())))
    return out


def main(argv):
    verbose = "-v" in argv
    words = [a for a in argv if not a.startswith("-")]
    if "-h" in argv or "--help" in argv:
        print(__doc__.strip())
        return 0
    available = set()
    if have_docker():
        available.add("docker")
    if os.access(DSH, os.X_OK):
        available.add("dsh")
    rows, failed = [], 0
    for name, cwd, cmd, needs in suites():
        if words and not any(w in name for w in words):
            continue
        missing = sorted(n for n in needs if not n.startswith("venv:") and n not in available)
        venv = [n[5:] for n in needs if n.startswith("venv:")]
        if venv and not os.access(venv[0], os.X_OK):
            rows.append((name, "SKIP", "no environment; run: uv sync --frozen --project tools/%s"
                         % name))
            continue
        if missing:
            rows.append((name, "SKIP", "needs " + ", ".join(missing)))
            continue
        start = time.time()
        try:
            p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=TIMEOUT)
            code, text = p.returncode, (p.stdout + p.stderr)
        except subprocess.TimeoutExpired:
            code, text = 124, "timed out after %d s" % TIMEOUT
        lines = [ln for ln in text.strip().splitlines() if ln.strip()]
        last = lines[-1].strip() if lines else ""
        status = "ok" if code == 0 else "FAIL"
        failed += code != 0
        rows.append((name, status, "%s  (%.0f s)" % (last[:90], time.time() - start)))
        sys.stderr.write("%-4s %s\n" % (status, name))
        if verbose or code != 0:
            sys.stderr.write(text[-3000:] + "\n")
    if not rows:
        print("no suite matches %s" % " ".join(words))
        return 2
    width = max(len(r[0]) for r in rows)
    print()
    for name, status, detail in rows:
        print("%-*s  %-4s  %s" % (width, name, status, detail))
    skipped = sum(r[1] == "SKIP" for r in rows)
    print("\n%d suites: %d ok, %d failed, %d skipped"
          % (len(rows), len(rows) - failed - skipped, failed, skipped))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
