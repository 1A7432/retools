class StageError(Exception):
    pass


def read_manifest(public):
    path = os.path.join(public, "MANIFEST.sha256")
    entries = {}
    try:
        with open(path, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except OSError as exc:
        raise StageError("cannot read %s: %s" % (path, exc))
    for line in lines:
        if not line.strip() or line.startswith("#"):
            continue
        m = re.match(r"^([0-9a-fA-F]{64}) [ *](.+)$", line)
        if not m:
            raise StageError("bad MANIFEST.sha256 line: %r" % line[:200])
        rel = m.group(2)
        while rel.startswith("./"):
            rel = rel[2:]
        entries[rel] = m.group(1).lower()
    return entries


def copy_verified(src, dst, want):
    """Copy a regular file (never following a symlink) and check its sha256."""
    st = os.lstat(src)
    if not stat.S_ISREG(st.st_mode):
        raise StageError("%s is not a regular file" % src)
    fd = os.open(src, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    with os.fdopen(fd, "rb") as fh:
        data = fh.read()
    got = hashlib.sha256(data).hexdigest()
    if got != want:
        raise StageError("%s does not match MANIFEST.sha256 (%s != %s)" % (src, got, want))
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    with open(dst, "wb") as fh:
        fh.write(data)
    os.chmod(dst, 0o644)
    return len(data)


def target_questions(questions, target):
    return [q for q in questions if isinstance(q, dict) and q.get("target") == target]


def stage(bench, target, run_dir):
    """Copy README.md, <target>/ and the target's questions into <run>/public.

    Returns {"files": [[rel, size, sha256]], "questions": [...], "warnings": [...]}.
    """
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]*", target or ""):
        raise StageError("bad target name %r" % target)
    public = os.path.join(bench, "public")
    tdir = os.path.join(public, target)
    if os.path.islink(tdir) or not os.path.isdir(tdir):
        raise StageError("%s is not a directory" % tdir)
    manifest = read_manifest(public)
    warnings = []
    qpath = os.path.join(public, "questions.json")
    if "questions.json" in manifest:
        if sha256_file(qpath) != manifest["questions.json"]:
            raise StageError("questions.json does not match MANIFEST.sha256")
    else:
        warnings.append("questions.json is not listed in MANIFEST.sha256")
    questions = load_json(qpath)
    if not isinstance(questions, list):
        raise StageError("%s is not a JSON list" % qpath)
    mine = target_questions(questions, target)
    if not mine:
        raise StageError("no questions have target %r" % target)
    ids = [q.get("id") for q in mine]
    if len(set(ids)) != len(ids) or not all(isinstance(i, str) and i for i in ids):
        raise StageError("question ids of %s are missing or repeated: %s" % (target, ids))
    dest = os.path.join(run_dir, "public")
    os.makedirs(dest, exist_ok=True)
    files = []
    if "README.md" not in manifest:
        raise StageError("README.md is not listed in MANIFEST.sha256")
    wanted = ["README.md"] + sorted(r for r in manifest if r.startswith(target + "/"))
    on_disk = set()
    for d, dirs, names in os.walk(tdir):
        for name in dirs + names:
            p = os.path.join(d, name)
            rel = os.path.relpath(p, public)
            if os.path.islink(p):
                raise StageError("%s is a symbolic link" % rel)
            if os.path.isfile(p):
                on_disk.add(rel)
    extra = sorted(on_disk - set(wanted))
    if extra:
        raise StageError("files under %s/ are not in MANIFEST.sha256: %s" % (target, extra))
    for rel in wanted:
        if posixpath.normpath(rel) != rel or rel.startswith("/") or ".." in rel.split("/"):
            raise StageError("bad MANIFEST path %r" % rel)
        size = copy_verified(os.path.join(public, rel), os.path.join(dest, rel), manifest[rel])
        files.append([rel, size, manifest[rel]])
    qtext = json.dumps(mine, ensure_ascii=False, indent=2) + "\n"
    with open(os.path.join(dest, "questions.json"), "w", encoding="utf-8") as fh:
        fh.write(qtext)
    files.append(["questions.json", len(qtext.encode("utf-8")),
                  hashlib.sha256(qtext.encode("utf-8")).hexdigest()])
    for q in mine:
        rel = (q.get("impl") or {}).get("samples")
        if q.get("impl") and not (q["impl"].get("function") and rel):
            raise StageError("%s: impl needs function and samples" % q["id"])
        if rel and not os.path.isfile(os.path.join(dest, rel)):
            raise StageError("%s: samples file %s is not staged" % (q["id"], rel))
    for root, dirs, names in os.walk(dest):
        os.chmod(root, 0o755)
    return {"files": files, "questions": mine, "warnings": warnings}


def recheck_staging(run_dir, run):
    """Compare <run>/public with what was staged and with the bench's manifest."""
    problems = []
    dest = os.path.join(run_dir, "public")
    staged = {rel: sha for rel, _size, sha in run["staging"]["files"]}
    found = set()
    for d, dirs, names in os.walk(dest):
        for name in dirs + names:
            p = os.path.join(d, name)
            rel = os.path.relpath(p, dest)
            if os.path.islink(p):
                problems.append("staged public has a symbolic link %s" % rel)
            elif os.path.isfile(p):
                found.add(rel)
    if found != set(staged):
        problems.append("staged public files changed: extra %s, missing %s"
                        % (sorted(found - set(staged)), sorted(set(staged) - found)))
    for rel in sorted(found & set(staged)):
        if sha256_file(os.path.join(dest, rel)) != staged[rel]:
            problems.append("staged %s changed during the run" % rel)
    try:
        manifest = read_manifest(os.path.join(run["bench"], "public"))
    except StageError as exc:
        problems.append("cannot re-read the bench manifest: %s" % exc)
        return problems
    for rel, sha in staged.items():
        if rel == "questions.json":
            continue
        if manifest.get(rel) != sha:
            problems.append("staged %s does not match the bench's MANIFEST.sha256" % rel)
    return problems


