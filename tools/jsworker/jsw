def export_submission(run_dir):
    """Copy work/submission/ to <run>/submission/: regular files only, never
    following a symlink, so a link the worker made cannot pull host files in."""
    src = os.path.join(run_dir, "work", "submission")
    dst = os.path.join(run_dir, "submission")
    if os.path.lexists(dst):
        shutil.rmtree(dst)
    os.makedirs(dst)
    report = {"dir": dst, "files": [], "skipped": []}
    if os.path.islink(src):
        report["skipped"].append({"name": "submission", "why": "work/submission is a "
                                  "symbolic link to %s" % os.readlink(src)})
        return report
    if not os.path.isdir(src):
        report["skipped"].append({"name": "submission", "why": "work/submission does not exist"})
        return report
    for name in sorted(os.listdir(src)):
        p = os.path.join(src, name)
        st = os.lstat(p)
        if stat.S_ISLNK(st.st_mode):
            report["skipped"].append({"name": name, "why": "symbolic link to %s"
                                      % os.readlink(p)})
        elif not stat.S_ISREG(st.st_mode):
            report["skipped"].append({"name": name, "why": "not a regular file"})
        elif not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,99}", name):
            report["skipped"].append({"name": name, "why": "unexpected file name"})
        elif st.st_size > MAX_SUBMISSION_FILE:
            report["skipped"].append({"name": name, "why": "larger than %d bytes"
                                      % MAX_SUBMISSION_FILE})
        else:
            fd = os.open(p, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
            with os.fdopen(fd, "rb") as fh:
                data = fh.read(MAX_SUBMISSION_FILE + 1)
            with open(os.path.join(dst, name), "wb") as fh:
                fh.write(data)
            report["files"].append(name)
    return report


def scan_symlinks(work):
    """Symbolic links under work/, with where they point inside the container."""
    found = []
    for d, dirs, names in os.walk(work, followlinks=False):
        for name in dirs + names:
            p = os.path.join(d, name)
            if not os.path.islink(p):
                continue
            target = os.readlink(p)
            cpath = "/task/work/" + os.path.relpath(p, work)
            resolved = posixpath.normpath(target if target.startswith("/") else
                                          posixpath.join(posixpath.dirname(cpath), target))
            found.append({"path": cpath, "target": target,
                          "inside": resolved == "/task" or resolved.startswith("/task/")})
            if len(found) >= 100:
                return found
    return found


def host_fragments(run_dir, bench):
    frags = {os.path.realpath(run_dir), os.path.realpath(bench), os.path.realpath(RUNS),
             os.path.realpath(RE_DIR), os.path.realpath(HERE), os.path.expanduser("~"),
             run_dir, bench}
    return sorted((f for f in frags if f and len(f) > 6), key=len, reverse=True)


SEALED_RE = re.compile(r"(?i)\bsealed\b")
PATH_KEYS = {"fs_list": ["path"], "fs_read": ["path"], "fs_grep": ["path"],
             "fs_write": ["path"], "fs_edit": ["path"], "node_run": ["file"],
             "py_run": ["file"], "js_beautify": ["path", "out"]}
WRITE_KEYS = {("fs_write", "path"), ("fs_edit", "path"), ("js_beautify", "out")}


def audit(outcomes, log, run, symlinks, staging_problems, container_problems, export):
    """Breaches: things that are impossible by construction. Flags: worker
    behaviour worth a look (attempts that were refused, host paths, 'sealed').
    Notes: everything else worth knowing."""
    breaches, flags, notes = [], [], []
    names = set(TOOL_NAMES)
    completed = 0
    for i, o in enumerate(outcomes, 1):
        for c in o["calls"]:
            tool = c.get("tool")
            if tool in names:
                if c.get("status") == "completed":
                    completed += 1
                continue
            err = c.get("error") or {}
            if c.get("status") == "error" and err.get("code") == "UNKNOWN_TOOL":
                notes.append("attempt %d: the model asked for %r, which is not registered; "
                             "dsh rejected the call" % (i, tool))
            else:
                breaches.append("attempt %d: the event stream shows a call to %r (status %s);"
                                " only the jsre tools should exist" % (i, tool, c.get("status")))
    calls = [r for r in log if r.get("event") == "call"]
    ran = [r for r in calls if r.get("allowed") and not r.get("refused")]
    if completed > len(ran):
        breaches.append("%d jsre tool results in the event stream, but only %d calls ran in "
                        "jsre_mcp.py" % (completed, len(ran)))
    for r in log:
        if r.get("event") == "start":
            if r.get("max_calls") != run["max_calls"] or r.get("container") != run["container"]:
                breaches.append("jsre_mcp.py ran with container %s / max %s instead of %s / %s"
                                % (r.get("container"), r.get("max_calls"), run["container"],
                                   run["max_calls"]))
        elif r.get("event") == "fatal":
            notes.append("jsre_mcp.py stopped (fail closed): %s" % r.get("reason"))
    over = 0
    frags = host_fragments(run["run_dir"], run["bench"])
    arg_text = ""
    for r in calls:
        tool, args = r.get("tool"), r.get("arguments")
        n = r.get("call_no")
        label = "call %s %s" % (n if n is not None else "-", tool)
        args_json = json.dumps(args, ensure_ascii=False)
        arg_text += args_json
        if r.get("over_budget"):
            over += 1
            if tool not in jsre_mcp.SUBMIT_TOOLS and r.get("allowed"):
                breaches.append("%s ran after the call budget" % label)
        if n is not None and n > run["max_calls"] and not r.get("over_budget"):
            breaches.append("%s ran past the budget of %d" % (label, run["max_calls"]))
        if r.get("refused") and r.get("reason") and ("outside" in r["reason"]):
            flags.append("%s refused: %s" % (label, r["reason"][:300]))
        if r.get("allowed") and not r.get("refused") and isinstance(args, dict):
            for key in PATH_KEYS.get(tool, []):
                if isinstance(args.get(key), str):
                    try:
                        jsre_mcp.check_path(args[key], key, write=(tool, key) in WRITE_KEYS)
                    except jsre_mcp.Refusal as exc:
                        breaches.append("%s ran with %s outside the sandbox: %s"
                                        % (label, key, exc))
        for f in frags:
            if f in args_json:
                flags.append("%s arguments contain the host path %s" % (label, f))
                break
        if SEALED_RE.search(args_json):
            flags.append("%s arguments mention 'sealed'" % label)
    if over > jsre_mcp.GRACE_CALLS:
        breaches.append("%d calls ran after the budget; at most %d may"
                        % (over, jsre_mcp.GRACE_CALLS))
    for r in calls:
        res = r.get("result") or ""
        for f in frags:
            if f in res:
                where = "the worker had typed it" if f in arg_text else "it came from the sandbox"
                (flags if f in arg_text else breaches).append(
                    "call %s %s result contains the host path %s (%s)"
                    % (r.get("call_no"), r.get("tool"), f, where))
                break
    for s in symlinks:
        if not s["inside"]:
            flags.append("symbolic link %s -> %s points outside /task" % (s["path"], s["target"]))
    for s in export["skipped"]:
        notes.append("submission file %s not exported: %s" % (s["name"], s["why"]))
    breaches += ["staging: " + p for p in staging_problems]
    breaches += ["container: " + p for p in container_problems]
    return {"ok": not breaches, "breaches": breaches, "flags": flags, "notes": notes}


def read_log(path):
    out = []
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if isinstance(rec, dict):
                    out.append(rec)
    except FileNotFoundError:
        pass
    return out


def load_outcomes(run_dir, attempts):
    outcomes = []
    for a in attempts:
        path = os.path.join(run_dir, "events-%s.jsonl" % a["tag"])
        try:
            with open(path, "rb") as fh:
                lines = fh.read().decode("utf-8", "replace").splitlines()
        except OSError:
            lines = []
        outcomes.append(backend_dsh.parse_events(lines))
    return outcomes


def finalize(run_dir, run, attempts):
    """Export, audit, remove the container and write summary.json."""
    name = run["container"]
    check = None
    facts = inspect_container(name)
    if facts and (facts.get("State") or {}).get("Running"):
        try:
            c = jsre_mcp.Container(name, DOCKER, run.get("docker_host"))
            rep = jsre_mcp.submit_check(c)
            check = {k: rep[k] for k in ("errors", "warnings", "passed", "failed", "missing",
                                         "answered", "text")}
        except Exception as exc:
            check = {"error": "%s: %s" % (type(exc).__name__, exc)}
    container_problems = [p for p in verify_container(facts, run_dir, run["image"])
                          if p != "container is not running"] if facts else []
    remove_container(name)
    export = export_submission(run_dir)
    log = read_log(run["log"])
    outcomes = load_outcomes(run_dir, attempts)
    symlinks = scan_symlinks(os.path.join(run_dir, "work"))
    report = audit(outcomes, log, run, symlinks, recheck_staging(run_dir, run),
                   container_problems, export)
    if not facts:
        report["notes"].append("the container was gone before the run ended")
    tokens = {}
    for o in outcomes:
        for k, v in o["usage"].items():
            tokens[k] = tokens.get(k, 0) + v
    if any(o["steps_without_usage"] for o in outcomes):
        tokens["incomplete"] = True
    calls = [r for r in log if r.get("event") == "call"]
    by_tool = {}
    for r in calls:
        by_tool[r.get("tool")] = by_tool.get(r.get("tool"), 0) + 1
    numbered = [r["call_no"] for r in calls if isinstance(r.get("call_no"), int)]
    last = attempts[-1] if attempts else {}
    if last.get("timed_out"):
        status = "timed_out"
    elif last.get("final") is not None and (last.get("reason") or {}).get("kind") == "completed":
        status = "finished"
    else:
        status = "failed"
    answers = load_json(os.path.join(export["dir"], "answers.json"))
    qids = [q["id"] for q in run["staging"]["questions"]]
    answered = sorted(k for k in (answers or {}) if k in qids) \
        if isinstance(answers, dict) else []
    summary = {
        "run_id": run["run_id"], "target": run["target"], "status": status,
        "model": run["model"], "effort": run["effort"], "timeout": run["timeout"],
        "max_calls": run["max_calls"], "bench": run["bench"], "image": run["image"],
        "container": name, "session": next((a.get("session") for a in attempts
                                            if a.get("session")), None),
        "seconds": round(sum(a.get("seconds") or 0 for a in attempts), 1),
        "attempts": attempts, "tokens": tokens,
        "tool_calls": {"total": len(calls), "by_tool": by_tool,
                       "refused": sum(1 for r in calls if r.get("refused")),
                       "budget_used": min(max(numbered or [0]), run["max_calls"]),
                       "over_budget": sum(1 for r in calls if r.get("over_budget"))},
        "submission": dict(export, answered=answered,
                           missing=[q for q in qids if q not in answered]),
        "submit_check": check,
        "audit": report,
        "final_text": (last.get("final") or "")[-2000:],
        "run_dir": run_dir,
    }
    save_json(os.path.join(run_dir, "summary.json"), summary)
    return summary


def exit_code(summary):
    if not summary["audit"]["ok"]:
        return 3
    return 0 if summary["status"] == "finished" else 1


def attempt_record(tag, outcome):
    return {"tag": tag, "session": outcome["session"], "exit": outcome["exit"],
            "timed_out": outcome["timed_out"], "seconds": outcome["seconds"],
            "reason": outcome["reason"], "final": outcome["final"], "steps": outcome["steps"],
            "tool_calls": len(outcome["calls"]), "usage": outcome["usage"],
            "errors": outcome["errors"][-5:], "stderr": outcome["stderr"][-1000:]}


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------

def blocked(problems):
    emit({"status": "blocked", "problems": problems})
    return 2


def readiness(backend):
    return backend.problems() + image_problems()


def find_run(run_id):
    path = run_id if os.path.isdir(run_id) else os.path.join(RUNS, run_id)
    if not os.path.isfile(os.path.join(path, "run.json")):
        raise SystemExit("jsw: no run %s (looked in %s)" % (run_id, path))
    return os.path.realpath(path)


def write_pid(run_dir):
    with open(os.path.join(run_dir, "jsw.pid"), "w") as fh:
        fh.write(str(os.getpid()))


def clear_pid(run_dir):
    try:
        os.unlink(os.path.join(run_dir, "jsw.pid"))
    except OSError:
        pass


def execute(backend, run_dir, run, attempts, prompt, timeout, session=None):
    tag = str(len(attempts) + 1)
    with open(os.path.join(run_dir, "prompt-%s.txt" % tag if attempts else "prompt.txt"),
              "w", encoding="utf-8") as fh:
        fh.write(prompt)
    settings = {"run_dir": run_dir, "cwd": os.path.join(run_dir, "dsh-cwd"),
                "container": run["container"], "log": run["log"],
                "max_calls": run["max_calls"], "model": run.get("model_arg"),
                "effort": run.get("effort_arg"), "docker_host": run.get("docker_host")}
    backend.write_overlay(settings)
    outcome = backend.run(prompt, settings, timeout, session=session, tag=tag)
    attempts.append(attempt_record(tag, outcome))
    save_json(os.path.join(run_dir, "attempts.json"), attempts)
    return outcome


def cmd_run(args):
    backend = JsBackend()
    problems = readiness(backend)
    if problems:
        sys.stderr.write("jsw: not ready; run `jsw setup` / image/build.sh, then `jsw doctor`\n")
        return blocked(problems)
    bench = os.path.realpath(args.bench)
    run_id = "%s-%s-%s" % (time.strftime("%Y%m%d-%H%M%S"), args.target, secrets.token_hex(2))
    os.makedirs(RUNS, exist_ok=True)
    run_dir = os.path.join(os.path.realpath(RUNS), run_id)
    os.makedirs(os.path.join(run_dir, "work", "submission"))
    os.makedirs(os.path.join(run_dir, "dsh-cwd"))
    # the container user (uid 1000) writes here
    os.chmod(os.path.join(run_dir, "work"), 0o777)
    os.chmod(os.path.join(run_dir, "work", "submission"), 0o777)
    try:
        staging = stage(bench, args.target, run_dir)
    except (StageError, OSError) as exc:
        return blocked(["staging failed: %s" % exc, "run dir: %s" % run_dir])
    image = expected_image()
    run = {"run_id": run_id, "target": args.target, "bench": bench, "run_dir": run_dir,
           "model": args.model or backend_dsh.MODEL, "effort": args.effort or DEFAULT_EFFORT,
           "model_arg": args.model, "effort_arg": args.effort, "timeout": args.timeout,
           "max_calls": args.max_calls, "image": image, "container": container_name(run_id),
           "log": os.path.join(run_dir, "tools.jsonl"), "docker_host": docker_host(),
           "created": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "staging": staging}
    save_json(os.path.join(run_dir, "run.json"), run)
    readme = open(os.path.join(run_dir, "public", "README.md"), encoding="utf-8").read()
    intro_path = os.path.join(run_dir, "public", args.target, "README.md")
    intro = open(intro_path, encoding="utf-8").read() if os.path.isfile(intro_path) else None
    prompt = build_prompt(args.target, readme, staging["questions"], staging["files"],
                          args.max_calls, args.timeout, intro)
    write_pid(run_dir)
    try:
        name, cproblems = start_container(run_id, run_dir, image)
        if cproblems:
            remove_container(name)
            return blocked(cproblems + ["run dir: %s" % run_dir])
        attempts = []
        execute(backend, run_dir, run, attempts, prompt, args.timeout)
        summary = finalize(run_dir, run, attempts)
    finally:
        clear_pid(run_dir)
    emit(summary)
    if not summary["audit"]["ok"]:
        sys.stderr.write("jsw: AUDIT FAILED - %s\n" % "; ".join(summary["audit"]["breaches"]))
    return exit_code(summary)


def cmd_resume(args):
    run_dir = find_run(args.run_id)
    run = load_json(os.path.join(run_dir, "run.json"))
    attempts = load_json(os.path.join(run_dir, "attempts.json"), [])
    session = next((a.get("session") for a in attempts if a.get("session")), None)
    if not session:
        return blocked(["run %s has no dsh session to resume" % run["run_id"]])
    backend = JsBackend()
    problems = readiness(backend)
    if problems:
        return blocked(problems)
    if expected_image() != run["image"]:
        return blocked(["the image changed since the run started (%s -> %s)"
                        % (run["image"], expected_image())])
    if os.path.exists(os.path.join(run_dir, "jsw.pid")):
        try:
            pid = int(open(os.path.join(run_dir, "jsw.pid")).read())
            os.kill(pid, 0)
            return blocked(["run %s is still active (jsw pid %d)" % (run["run_id"], pid)])
        except (ValueError, OSError):
            pass
    write_pid(run_dir)
    try:
        facts = inspect_container(run["container"])
        if facts:
            remove_container(run["container"])
        name, cproblems = start_container(run["run_id"], run_dir, run["image"])
        if cproblems:
            remove_container(name)
            return blocked(cproblems)
        timeout = args.timeout if args.timeout is not None else run["timeout"]
        execute(backend, run_dir, run, attempts, args.prompt or RESUME_PROMPT, timeout,
                session=session)
        summary = finalize(run_dir, run, attempts)
    finally:
        clear_pid(run_dir)
    emit(summary)
    return exit_code(summary)


def cmd_merge(args):
    out = os.path.abspath(args.o)
    if os.path.exists(out) and os.listdir(out) and not args.force:
        return blocked(["%s exists and is not empty (use --force to add to it)" % out])
    merged, sources, files, problems = {}, {}, {}, []
    for rid in args.run_ids:
        run_dir = find_run(rid)
        run = load_json(os.path.join(run_dir, "run.json"))
        summary = load_json(os.path.join(run_dir, "summary.json"))
        if not summary:
            problems.append("%s has no summary.json (did it finish?)" % rid)
            continue
        if not summary["audit"]["ok"] and not args.force:
            problems.append("%s failed its audit; use --force to merge it anyway" % rid)
            continue
        sub = os.path.join(run_dir, "submission")
        questions = {q["id"]: q for q in run["staging"]["questions"]}
        apath = os.path.join(sub, "answers.json")
        answers = load_json(apath) if os.path.isfile(apath) and not os.path.islink(apath) \
            else None
        if not isinstance(answers, dict):
            problems.append("%s: submission/answers.json is missing or not a JSON object" % rid)
            answers = {}
        for qid, val in answers.items():
            if qid not in questions:
                problems.append("%s: %s is not a question of target %s"
                                % (rid, qid, run["target"]))
                continue
            if qid in merged:
                problems.append("%s answered by both %s and %s" % (qid, sources[qid], rid))
                continue
            merged[qid] = val
            sources[qid] = rid
        for qid, q in questions.items():
            if not q.get("impl"):
                continue
            val = answers.get(qid)
            fname = val if isinstance(val, str) and re.fullmatch(
                r"[A-Za-z0-9][A-Za-z0-9._-]*\.py", val) else qid + ".py"
            p = os.path.join(sub, fname)
            if os.path.isfile(p) and not os.path.islink(p):
                if fname in files:
                    problems.append("%s comes from both %s and %s" % (fname, files[fname][0], rid))
                else:
                    files[fname] = (rid, p)
    if problems:
        return blocked(problems)
    os.makedirs(out, exist_ok=True)
    existing = load_json(os.path.join(out, "answers.json"), {}) if args.force else {}
    clash = sorted(set(existing) & set(merged))
    if clash:
        return blocked(["%s already has answers for %s" % (out, clash)])
    existing.update(merged)
    save_json(os.path.join(out, "answers.json"), dict(sorted(existing.items())))
    for fname, (rid, p) in sorted(files.items()):
        shutil.copyfile(p, os.path.join(out, fname))
    emit({"ok": True, "out": out, "answers": len(merged), "files": sorted(files),
          "from": {rid: sorted(q for q, r in sources.items() if r == rid)
                   for rid in args.run_ids}})
    return 0


def cmd_gc(args):
    rc, out, err = docker("ps", "-a", "--filter", "label=jsw.run", "--format",
                          '{{.Names}}\t{{.Label "jsw.pid"}}\t{{.State}}')
    if rc != 0:
        return blocked(["docker ps failed: %s" % (err or out).strip()[-300:]])
    removed, kept = [], []
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) < 3:
            continue
        name, pid, state = parts[0], parts[1], parts[2]
        alive = False
        try:
            os.kill(int(pid), 0)
            alive = True
        except (ValueError, OSError):
            pass
        if alive:
            kept.append({"container": name, "why": "jsw pid %s is still running" % pid})
            continue
        if not args.dry_run:
            remove_container(name)
        removed.append({"container": name, "state": state})
    emit({"ok": True, "dry_run": args.dry_run, "removed": removed, "kept": kept})
    return 0


def cmd_setup(args):
    res = JsBackend().setup()
    emit(res)
    return 0 if res["ok"] else 1


def cmd_doctor(args):
    checks = JsBackend().doctor()
    ok = all(c["ok"] for c in checks)
    emit({"ok": ok, "checks": checks})
    return 0 if ok else 1


def parser():
    ap = argparse.ArgumentParser(prog="jsw", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("setup", help="create or refresh the js-worker dsh profile")
    sub.add_parser("doctor", help="check the installation and what the model is offered")
    run = sub.add_parser("run", help="run one target")
    run.add_argument("--target", required=True, help="target directory, e.g. t3")
    run.add_argument("--model", help="model id (default %s)" % backend_dsh.MODEL)
    run.add_argument("--effort", choices=backend_dsh.EFFORTS,
                     help="reasoning effort (default %s)" % DEFAULT_EFFORT)
    run.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT,
                     help="wall-clock seconds (default %(default)s)")
    run.add_argument("--max-calls", type=int, default=DEFAULT_MAX_CALLS,
                     help="tool-call budget (default %(default)s)")
    run.add_argument("--bench", default=BENCH, help="benchmark dir (default %(default)s)")
    res = sub.add_parser("resume", help="continue a run's dsh session")
    res.add_argument("run_id")
    res.add_argument("--prompt", help="message for the worker (default: continue)")
    res.add_argument("--timeout", type=float, help="seconds (default: the run's --timeout)")
    mrg = sub.add_parser("merge", help="merge runs' exported submissions into one directory")
    mrg.add_argument("run_ids", nargs="+")
    mrg.add_argument("-o", required=True, help="output directory")
    mrg.add_argument("--force", action="store_true",
                     help="merge runs whose audit failed / add to a non-empty directory")
    gc = sub.add_parser("gc", help="remove containers of runs that are no longer active")
    gc.add_argument("--dry-run", action="store_true")
    return ap


def main(argv=None):
    args = parser().parse_args(argv)
    if not args.cmd:
        parser().print_help()
        return 2
    if args.cmd == "run" and args.max_calls < 1:
        return blocked(["--max-calls must be at least 1"])
    return {"setup": cmd_setup, "doctor": cmd_doctor, "run": cmd_run, "resume": cmd_resume,
            "merge": cmd_merge, "gc": cmd_gc}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
