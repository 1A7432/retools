def build_prompt(target, readme, questions, files, max_calls, timeout, intro=None):
    lines = ["You are working on one target of a JavaScript reverse-engineering benchmark. "
             "Everything you need is in a sandbox that you reach only through the "
             "mcp__jsre__* tools.", "",
             "## Target %s" % target, ""]
    if intro:
        lines += [intro.strip(), ""]
    else:
        lines += ["/task/public/%s/ holds the front-end JavaScript of a website, as captured "
                  "from its pages. The site's API requests carry values computed by this "
                  "(obfuscated) code. The questions below are about how that code works."
                  % target, ""]
    lines += ["Files (read-only):"]
    for rel, size, _sha in files:
        lines.append("  /task/public/%s  (%d bytes)" % (rel, size))
    lines += ["Your working directory is /task/work (read-write); nothing else is visible.", "",
              "## Common instructions (/task/public/README.md)", "", readme.strip(), "",
              "## Questions (%d; also in /task/public/questions.json)" % len(questions), ""]
    for q in questions:
        lines.append("### %s" % q["id"])
        lines.append(str(q.get("question", "")).strip())
        if q.get("answer_format"):
            lines.append("Answer format: %s" % q["answer_format"])
        impl = q.get("impl")
        if impl:
            lines.append("Implementation question: write /task/work/submission/%s.py defining "
                         "`%s`; its public samples are in /task/public/%s under the key %s."
                         % (q["id"], impl.get("function"), impl.get("samples"),
                            json.dumps(q["id"])))
        lines.append("")
    lines += [
        "## Submission",
        "Write /task/work/submission/answers.json: one JSON object mapping each question id "
        "to your answer. For an implementation question the value is the file name "
        "(\"<id>.py\") of your implementation, which goes next to answers.json. Only "
        "/task/work/submission/ is graded; your final chat reply is not. Write answers.json "
        "early and keep it up to date as you go, and run submit_check to validate it.", "",
        "## Tools",
        "fs_list, fs_read, fs_grep, fs_write, fs_edit (files), node_run (Node.js 22 with the "
        "Babel/acorn AST libraries), py_run (Python 3.13 with pycryptodome and gmssl), "
        "js_beautify (re-indent a JS file) and submit_check. Paths are absolute container "
        "paths under /task. There is no shell, no network, no package installation and no "
        "debugger.", "",
        "## Budget",
        "%d tool calls and %d minutes of wall-clock time. When the calls are used up only "
        "fs_write, fs_edit and submit_check keep working, for a few more calls." % (
            max_calls, max(1, int(timeout // 60))), "",
        "When you are done, reply with a short plain-text summary of what you submitted."]
    return "\n".join(lines) + "\n"


