def docker(*args, timeout=120):
    try:
        p = subprocess.run([DOCKER] + list(args), capture_output=True, text=True,
                           timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 255, "", str(exc)
    return p.returncode, p.stdout, p.stderr


def docker_host():
    """The endpoint of the current docker context, passed on to jsre_mcp.py so it
    does not depend on the environment dsh gives its MCP servers."""
    if os.environ.get("DOCKER_HOST"):
        return os.environ["DOCKER_HOST"]
    rc, out, _ = docker("context", "inspect", "--format", "{{.Endpoints.docker.Host}}")
    return out.strip() if rc == 0 and out.strip() else None


def expected_image():
    try:
        with open(IMAGE_DIGEST) as fh:
            return fh.read().strip() or None
    except OSError:
        return None


def image_problems():
    want = expected_image()
    if not want:
        return ["%s is missing; build the image with image/build.sh" % IMAGE_DIGEST]
    rc, out, err = docker("image", "inspect", "--format", "{{.Id}}", IMAGE_TAG)
    if rc != 0:
        return ["image %s is not present (%s); run image/build.sh"
                % (IMAGE_TAG, (err or out).strip()[-200:])]
    if out.strip() != want:
        return ["image %s is %s but IMAGE_DIGEST says %s; rebuild or update IMAGE_DIGEST"
                % (IMAGE_TAG, out.strip(), want)]
    return []


def container_name(run_id):
    return "jsw-" + run_id


def start_container(run_id, run_dir, image):
    """docker run as in HARNESS.md section 4. Returns (name, problems)."""
    name = container_name(run_id)
    pub = os.path.realpath(os.path.join(run_dir, "public"))
    work = os.path.realpath(os.path.join(run_dir, "work"))
    rc, out, err = docker(
        "run", "-d", "--name", name, "--label", "jsw.run=%s" % run_id,
        "--label", "jsw.pid=%d" % os.getpid(),
        "--network", "none", "--read-only", "--tmpfs", "/tmp:rw,size=256m",
        "--user", "1000:1000", "--cap-drop", "ALL", "--security-opt", "no-new-privileges",
        "--memory", "4g", "--cpus", "2", "--pids-limit", "128",
        "-e", "TZ=UTC", "-e", "LANG=C.UTF-8",
        "-v", "%s:/task/public:ro" % pub, "-v", "%s:/task/work:rw" % work,
        image, "sleep", "infinity")
    if rc != 0:
        return name, ["docker run failed: %s" % (err or out).strip()[-500:]]
    return name, verify_container(inspect_container(name), run_dir, image)


def inspect_container(name):
    rc, out, err = docker("inspect", name)
    if rc != 0:
        return None
    try:
        return json.loads(out)[0]
    except (ValueError, IndexError):
        return None


def verify_container(facts, run_dir, image):
    """What differs from the sandbox the run must have."""
    if not facts:
        return ["the container does not exist"]
    problems = []
    hc = facts.get("HostConfig") or {}
    cfg = facts.get("Config") or {}
    if not (facts.get("State") or {}).get("Running"):
        problems.append("container is not running")
    if facts.get("Image") != image:
        problems.append("container image %s is not %s" % (facts.get("Image"), image))
    if hc.get("NetworkMode") != "none":
        problems.append("network mode %s is not none" % hc.get("NetworkMode"))
    nets = sorted(((facts.get("NetworkSettings") or {}).get("Networks") or {}).keys())
    if nets not in ([], ["none"]):
        problems.append("container is attached to networks %s" % nets)
    if not hc.get("ReadonlyRootfs"):
        problems.append("root filesystem is writable")
    if "ALL" not in (hc.get("CapDrop") or []) or hc.get("CapAdd"):
        problems.append("capabilities are not all dropped (%s / %s)"
                        % (hc.get("CapDrop"), hc.get("CapAdd")))
    if not any(o.startswith("no-new-privileges") for o in hc.get("SecurityOpt") or []):
        problems.append("no-new-privileges is not set")
    if hc.get("Privileged"):
        problems.append("container is privileged")
    if cfg.get("User") != "1000:1000":
        problems.append("container user %s is not 1000:1000" % cfg.get("User"))
    pub = os.path.realpath(os.path.join(run_dir, "public"))
    work = os.path.realpath(os.path.join(run_dir, "work"))
    mounts = sorted((m.get("Type"), os.path.realpath(m.get("Source") or ""),
                     m.get("Destination"), bool(m.get("RW")))
                    for m in facts.get("Mounts") or [])
    want = sorted([("bind", pub, "/task/public", False), ("bind", work, "/task/work", True)])
    if mounts != want:
        problems.append("mounts %s are not exactly %s" % (mounts, want))
    if set((hc.get("Tmpfs") or {}).keys()) - {"/tmp"}:
        problems.append("unexpected tmpfs mounts %s" % hc.get("Tmpfs"))
    if hc.get("Devices"):
        problems.append("devices are passed in: %s" % hc.get("Devices"))
    return problems


def remove_container(name):
    rc, out, err = docker("rm", "-f", name, timeout=60)
    return rc == 0 or "No such container" in err


