def overlay_text(settings, provider_rows=""):
    _y = backend_dsh._y
    state = os.path.join(settings["run_dir"], "dsh")
    args = ["--container", settings["container"], "--log", settings["log"],
            "--max-calls", str(settings["max_calls"]), "--docker", settings.get("docker") or DOCKER]
    if settings.get("docker_host"):
        args += ["--docker-host", settings["docker_host"]]
    rows = [
        "# jsw per-run overlay; generated, do not edit",
        "- id: %s" % MCP_ROW,
        "  name: %s" % _y(backend_dsh.MCP_CLIENT),
        "  config:",
        "    serverName: %s" % _y(SERVER),
        "    transport: stdio",
        "    command: %s" % _y(JSRE),
        "    args:",
        backend_dsh._yaml_list(args, 6),
        "    toolCallTimeoutMs: %d" % TOOL_TIMEOUT_MS,
        "    failOnStartupError: true",
        "    reconnect:",
        "      enabled: false",
        "- id: session-persistence-jsonl",
        "  name: \"@deepseek-ai/dsh-session-persistence-jsonl\"",
        "  config:",
        "    root: %s" % _y(os.path.join(state, "sessions")),
        "    compression: none",
        "- id: storage-json",
        "  name: \"@deepseek-ai/dsh-storage-json\"",
        "  config:",
        "    root: %s" % _y(os.path.join(state, "storages")),
    ]
    if settings.get("model") or settings.get("effort"):
        rows += [
            "- id: agent-default-model",
            "  name: \"@deepseek-ai/dsh-agent-default-model\"",
            "  config:",
            "    provider: %s" % _y(backend_dsh.PROVIDER),
            "    model: %s" % _y(settings.get("model") or backend_dsh.MODEL),
            "    reasoningEffort: %s" % _y(settings.get("effort") or DEFAULT_EFFORT),
        ]
    if provider_rows:
        rows.append(provider_rows.rstrip("\n"))
    return "\n".join(rows) + "\n"


class JsBackend(backend_dsh.DshBackend):
    def __init__(self, dsh=None):
        super().__init__(dsh=dsh, profile=PROFILE, repo_patch=PATCH, proxy=JSRE,
                         server=SERVER, tool_names=TOOL_NAMES, cli="jsw", runs_dir=RUNS)

    def write_overlay(self, settings, provider_rows=""):
        path = os.path.join(settings["run_dir"], "overlay.yml")
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(overlay_text(settings, provider_rows))
        return path

    def composed_config_problems(self):
        with tempfile.TemporaryDirectory(prefix="jsw-doctor-") as tmp:
            settings = {"run_dir": tmp, "container": "jsw-doctor", "max_calls": 5,
                        "log": os.path.join(tmp, "tools.jsonl")}
            overlay = self.write_overlay(settings)
            rc, out, err = self.dump_config([overlay])
            if rc != 0:
                return ["dump-config exit %s: %s" % (rc, err[-500:])]
            return backend_dsh.config_problems(
                backend_dsh.parse_dump(out), expect_log=settings["log"], proxy=JSRE,
                server=SERVER, mcp_row=MCP_ROW, tool_rows=TOOL_ROWS)

    def exposure_check(self, with_container=True):
        """Boot the real js-worker profile against fake_llm_server.py and the real
        jsre_mcp.py, record which tools dsh offered the model, and (with the
        image) check that one call ran in a container and one was refused."""
        tmp = tempfile.mkdtemp(prefix="jsw-doctor-")
        server = None
        name = None
        try:
            script = os.path.join(tmp, "script.json")
            with open(script, "w") as fh:
                json.dump([
                    {"tool_calls": [{"name": "mcp__jsre__fs_list",
                                     "arguments": {"path": "/task"}},
                                    {"name": "mcp__jsre__fs_read",
                                     "arguments": {"path": "/etc/passwd"}}]},
                    {"text": "done"}], fh)
            port_file = os.path.join(tmp, "port")
            server = subprocess.Popen([sys.executable,
                                       os.path.join(REWORKER, "fake_llm_server.py"),
                                       "--script", script, "--record",
                                       os.path.join(tmp, "llm"), "--port-file", port_file])
            for _ in range(100):
                if os.path.exists(port_file):
                    break
                time.sleep(0.05)
            with open(port_file) as fh:
                port = int(fh.read())
            for sub in ("public", "work", "dsh-cwd"):
                os.makedirs(os.path.join(tmp, sub))
            with open(os.path.join(tmp, "public", "README.md"), "w") as fh:
                fh.write("doctor\n")
            run_id = "doctor-%s" % secrets.token_hex(3)
            name = container_name(run_id)
            if with_container:
                name, cproblems = start_container(run_id, tmp, expected_image())
                if cproblems:
                    return {"ok": False, "problems": cproblems}
            settings = {"run_dir": tmp, "cwd": os.path.join(tmp, "dsh-cwd"),
                        "container": name, "max_calls": 5, "docker_host": docker_host(),
                        "log": os.path.join(tmp, "tools.jsonl")}
            self.write_overlay(settings, backend_dsh.fake_provider_rows(port))
            env = dict(os.environ, REW_FAKE_LLM_KEY="fake")
            outcome = self.run("doctor exposure check", settings, 180, env=env)
            req = os.path.join(tmp, "llm", "request-000.json")
            offered, system = [], ""
            if os.path.exists(req):
                with open(req) as fh:
                    body = json.load(fh)
                offered = sorted(t.get("function", {}).get("name")
                                 for t in body.get("tools") or [])
                system = json.dumps(body.get("messages") or [], ensure_ascii=False)
            problems = []
            if offered != TOOL_NAMES:
                problems.append("dsh offered the model %s" % offered)
            for leak in ("AGENTS.md", "CLAUDE.md", "SKILL.md"):
                if leak in system:
                    problems.append("the first request mentions %s; workspace instructions "
                                    "or skills reach the prompt" % leak)
            if with_container:
                log = [json.loads(l) for l in open(settings["log"])
                       if l.strip()] if os.path.exists(settings["log"]) else []
                calls = [(r.get("tool"), bool(r.get("refused")), bool(r.get("is_error")))
                         for r in log if r.get("event") == "call"]
                if sorted(calls) != [("fs_list", False, False), ("fs_read", True, True)]:
                    problems.append("jsre calls %s, expected fs_list to run and fs_read "
                                    "/etc/passwd to be refused" % calls)
            if outcome["exit"] != 0:
                problems.append("dsh exit %s: %s" % (outcome["exit"], outcome["stderr"][-300:]))
            return {"ok": not problems, "offered": offered, "problems": problems}
        except Exception as exc:
            return {"ok": False, "problems": ["%s: %s" % (type(exc).__name__, exc)]}
        finally:
            if server is not None:
                server.terminate()
                server.wait(5)
            if name and with_container:
                remove_container(name)
            shutil.rmtree(tmp, ignore_errors=True)

    def doctor(self):
        checks = []

        def add(name, ok, detail):
            checks.append({"check": name, "ok": bool(ok), "detail": detail})

        version, err = self.version()
        add("dsh", version is not None, version or err or "not found: %s" % self.dsh)
        problems = self.problems()
        add("profile", not problems, problems or backend_dsh.profile_dir(PROFILE))
        config_ok = False
        if os.path.isdir(backend_dsh.profile_dir(PROFILE)):
            cp = self.composed_config_problems()
            config_ok = not cp
            add("composed config", config_ok, cp or "%d rows disabled; %s -> %s"
                % (len(TOOL_ROWS), MCP_ROW, JSRE))
        rc, out, err = docker("version", "--format", "{{.Server.Version}}")
        add("docker", rc == 0, out.strip() if rc == 0 else (err or out).strip()[-300:])
        ip = image_problems() if rc == 0 else ["docker is not available"]
        add("image", not ip, ip or "%s = %s" % (IMAGE_TAG, expected_image()))
        if config_ok:
            exp = self.exposure_check(with_container=not ip)
            add("tools offered to the model", exp["ok"], exp["problems"] or exp.get("offered"))
        return checks


